## Copiá este archivo a .env (en la raíz del repo) y completá los valores
## Windows (PowerShell):
##   copy env.example .env

# Required (para LLM y avatar)
OPENAI_API_KEY=
# Live Avatar (obligatorio para el avatar)
LIVEAVATAR_API_KEY=

# Optional (avatar/voz)
# AVATAR_ID debe ser un UUID de app.liveavatar.com (ej. Ann Doctor Sitting)
AVATAR_ID=fc9c1f9f-bc99-4fd9-a6b2-8b4b5669a046
VOICE_ID=1a32e06dde934e69ba2a98a71675dc16
LANGUAGE=Spanish

# Optional: STT local (faster-whisper) vs cloud (OpenAI Whisper API)
# STT_MODE=openai | local
# Si STT_MODE=local, OPENAI_API_KEY no es necesaria para transcribir (solo para LLM si lo usás).
STT_MODE=local
STT_LANGUAGE=es
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1

# Anti falsos positivos (si lo subís a 2.0, se descartan frases cortas como "hola")
# STT_MIN_PHRASE_SECONDS=2.0

# Optional: logs
# LOG_DIR=logs

# Debug STT: imprimir y guardar el audio exacto que se manda a STT (para reproducirlo)
# STT_DEBUG_SAVE_WAV=1
# STT_DEBUG_WAV_DIR=logs/stt_audio


